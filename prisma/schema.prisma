generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accounts              Account[]
  sessions              Session[]
  cloudDocuments        CloudDocument[]
  cloudDocumentVersions CloudDocumentVersion[]
}

enum CloudDocumentLifecycle {
  ACTIVE
  ARCHIVED
  TRASHED
  DELETED
}

model CloudDocument {
  id                 String                 @id @default(cuid())
  userId             String
  clientDocumentId   String
  title              String                 @db.VarChar(100)
  content            Json
  clientCreatedAt    DateTime
  clientUpdatedAt    DateTime
  lifecycle          CloudDocumentLifecycle @default(ACTIVE)
  lifecycleChangedAt DateTime?
  isPinned           Boolean                @default(false)
  position           Float
  revision           Int                    @default(1)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           CloudDocumentVersion[]

  @@unique([userId, clientDocumentId])
  @@index([userId, lifecycle])
  @@index([userId, updatedAt])
}

enum CloudDocumentVersionReason {
  INITIAL
  AUTO
  LIFECYCLE
  PRE_RESTORE
  RESTORE
}

model CloudDocumentVersion {
  id                 String                     @id @default(cuid())
  documentId         String
  userId             String
  sourceRevision     Int
  title              String                     @db.VarChar(100)
  content            Json
  lifecycle          CloudDocumentLifecycle
  lifecycleChangedAt DateTime?
  isPinned           Boolean
  position           Float
  clientCreatedAt    DateTime
  clientUpdatedAt    DateTime
  reason             CloudDocumentVersionReason
  createdAt          DateTime                   @default(now())
  document           CloudDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, sourceRevision])
  @@index([documentId, createdAt])
  @@index([documentId, sourceRevision])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
