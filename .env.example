# Server-only. Copy to .env for Prisma CLI and Next.js; never commit filled values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rhyme_lines
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Canonical public origin. Also used to build verification and reset links.
AUTH_URL=http://localhost:3000
# Server-only Resend credentials for verification and password recovery email.
AUTH_EMAIL_FROM=Rhyme Lines <account@example.com>
RESEND_API_KEY=
# Non-Vercel deployments may set this only when a trusted proxy overwrites the named header.
# AUTH_TRUSTED_PROXY_HEADER=x-forwarded-for
# Required behind an unsupported reverse proxy; Vercel and Cloudflare Pages infer this.
# AUTH_TRUST_HOST=true
