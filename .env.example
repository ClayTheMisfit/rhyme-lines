# Server-only. Copy to .env for Prisma CLI and Next.js; never commit filled values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rhyme_lines
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional in Auth.js v5 unless the app uses a nonstandard base path.
AUTH_URL=http://localhost:3000
# Required behind an unsupported reverse proxy; Vercel and Cloudflare Pages infer this.
# AUTH_TRUST_HOST=true
