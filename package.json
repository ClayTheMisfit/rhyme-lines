{
  "name": "rhyme-lines",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:rhyme-db && next dev --turbopack",
    "build": "npm run build:rhyme-db && next build",
    "build:rhyme-db": "tsx scripts/build-rhyme-db-v2.ts",
    "vercel-build": "npm run build:rhyme-db && node scripts/check-rhyme-db.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint",
    "test": "jest",
    "test:db": "node --conditions=react-server --import tsx scripts/test-cloud-sync-db.ts",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "validate": "npm run typecheck && npm run lint && npm test -- --runInBand --silent && npm run build && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.0.0",
    "framer-motion": "^12.23.22",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-rnd": "^10.5.2",
    "server-only": "0.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
